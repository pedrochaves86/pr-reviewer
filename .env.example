# ══════════════════════════════════════════════════════
#  PR Auto-Reviewer — Configuração
#  Copia este ficheiro para .env e preenche os valores
# ══════════════════════════════════════════════════════

# ── Obrigatórias (mínimo para correr) ─────────────────
# Podes indicar vários URLs separados por vírgula.
GITHUB_PR_URL=

# Token com permissões: repo, pull_requests
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# O teu username GitHub (a review vai aparecer como sendo tua)
GITHUB_REVIEWER_LOGIN=teu-username-github

# ── Opcionais (advanced) ──────────────────────────────
# Requer `gh` + extensão `github/gh-models` autenticados com `gh auth login`.
GITHUB_MODELS_MODEL=openai/gpt-4.1
# GITHUB_MODELS_ORG=minha-org

# SonarQube
# SONAR_URL=https://sonar.agile.corp.edp.pt
# SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Checkmarx One
# CHECKMARX_URL=https://eu-2.ast.checkmarx.net
# CHECKMARX_TENANT=edp-certmng
# CHECKMARX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Idioma dos comentários: "pt" (Português) ou "en" (English)
# REVIEW_LANGUAGE=pt
