# ══════════════════════════════════════════════════════
#  PR Auto-Reviewer — Configuração
#  Copia este ficheiro para .env e preenche os valores
# ══════════════════════════════════════════════════════

# ── Acesso à App (recomendado em deploy público) ──────
# Define uma password para proteger o acesso à UI.
# No Streamlit Cloud: App settings > Secrets > APP_PASSWORD = "a-tua-password"
# Em local: podes deixar vazio; a app fica aberta sem autenticação.
APP_PASSWORD=

# ── Entrada Direta (opcional) ─────────────────────────
# Se definires este campo, o bot processa este(s) PR(s) e termina,
# sem ler Teams. Podes indicar vários URLs separados por vírgula.
GITHUB_PR_URL=

# ── Microsoft Teams (Graph API) ────────────────────────
# Como obter: Azure Portal → App Registrations → tua app
TEAMS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEAMS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEAMS_CLIENT_SECRET=your_client_secret_here

# Alvo de monitorização:
# Modo CANAL: TEAMS_TEAM_ID=<GUID do team> e TEAMS_CHANNEL_ID=<id do canal @thread.tacv2>
# Modo CHAT: deixa TEAMS_TEAM_ID vazio e usa TEAMS_CHANNEL_ID com id @thread.v2
# Também aceita link completo do Teams chat em TEAMS_CHANNEL_ID
TEAMS_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEAMS_CHANNEL_ID=19:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@thread.tacv2

# ── GitHub ────────────────────────────────────────────
# Token com permissões: repo, pull_requests
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# O teu username GitHub (a review vai aparecer como sendo tua)
GITHUB_REVIEWER_LOGIN=teu-username-github

# ── Anthropic (Claude) ────────────────────────────────
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── SonarQube (opcional) ──────────────────────────────
# Token: SonarQube -> My Account -> Security -> Generate Token
SONAR_URL=https://sonar.agile.corp.edp.pt
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Checkmarx One (opcional) ──────────────────────────
# API Key: https://eu-2.ast.checkmarx.net -> Settings -> API Keys -> Generate API Key
CHECKMARX_URL=https://eu-2.ast.checkmarx.net
CHECKMARX_TENANT=edp-certmng
CHECKMARX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Comportamento ─────────────────────────────────────
# Intervalo de polling em minutos (mínimo recomendado: 5)
POLL_INTERVAL_MINUTES=5

# Ficheiro para persistir PRs já processados
PROCESSED_PRS_FILE=processed_prs.json

# Idioma dos comentários: "pt" (Português) ou "en" (English)
REVIEW_LANGUAGE=pt
